# Required only for OpenAI-assisted proposals. Never put this key in browser code.
OPENAI_API_KEY=

# Optional; these defaults work by adding only OPENAI_API_KEY above.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=30
AUTOTUNER_LLM_MODE=auto
# auto: OpenAI when a key exists, otherwise local rules. Also accepts off/openai.
